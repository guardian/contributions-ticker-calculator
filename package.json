{
  "name": "ticker-calculator",
  "version": "1.0.0",
  "private": true,
  "buildDir": "./target",
  "scripts": {
    "lint": "eslint 'src/**/*.ts'",
    "prettier:check": "prettier --check ./src",
    "prettier:fix": "prettier --write ./src",
    "build": "esbuild src/lambda.ts src/local.ts --bundle --platform=node --outdir=target",
    "local": "Stage=CODE ts-node ./src/local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/client-ssm": "3.1045.0",
    "@aws-sdk/lib-storage": "3.1045.0",
    "@google-cloud/bigquery": "8.1.1",
    "google-auth-library": "10.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@guardian/eslint-config-typescript": "1.0.11",
    "@guardian/prettier": "1.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@types/node-fetch": "2.6.13",
    "esbuild": "0.28.0",
    "eslint": "8.57.1",
    "jest": "30.3.0",
    "prettier": "2.8.8",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "packageManager": "pnpm@10.33.0"
}
